# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
ENVIRONMENT=development
LOG_LEVEL=INFO
UPLOAD_DIR=storage/uploads
HEATMAP_DIR=storage/heatmaps
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
AUTO_APPROVE_THRESHOLD=0.10
AUTO_FLAG_THRESHOLD=0.90
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000

# Local RapidOCR handles text without an API key. Optional external verification
# receives the image to assess scope and joint meaning. It does not train Keras.
CONTEXT_VERIFICATION_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
VISION_TIMEOUT_SECONDS=35

# Optional fallback if RapidOCR cannot run. Windows installation is auto-detected.
TESSERACT_CMD=
OCR_LANGUAGES=eng
